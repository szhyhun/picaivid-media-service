# Copy to /etc/picaivid/media-worker.env on the staging GPU host.
# Do not commit the real /etc/picaivid/*.env files.
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# API auth (shared setting used internally)
API_KEY=replace-me

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# AWS
# Runtime auth should come from the EC2 IAM instance profile.
# Do not set AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY here when using IAM roles.
AWS_REGION=us-west-2
S3_BUCKET=picaivid-prod-media
SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/ACCOUNT_ID/picaivid-jobs
RAILS_WEBHOOK_URL=https://YOUR_RAILS_HOST

# Local-only endpoints. Omit these in AWS.
# S3_ENDPOINT=http://localhost:9000
# SQS_ENDPOINT=http://localhost:4566

# GPU worker metadata
WORKER_TYPE=gpu
ANALYSIS_MATCH_ENGINE=vggt_scene_graph

# Local artifact/cache paths hydrated from S3 before service startup.
MODEL_CACHE_DIR=/srv/picaivid/model-cache
VGGT_REPO_DIR=/srv/picaivid/third_party/vggt
VGGT_MODEL_CHECKPOINT=/srv/picaivid/third_party/vggt/checkpoints/vggt_1B_commercial.pt
VGGT_WINDOW_SIZE=24
VGGT_WINDOW_OVERLAP=6
VGGT_TRACK_POINTS_PER_IMAGE=64

# Optional S3 hydration fallback if artifacts are not pre-synced at boot.
# VGGT_REPO_ARCHIVE_S3_URI=s3://picaivid-prod-media/artifacts/vggt/repo/vggt.tar.gz
# VGGT_MODEL_CHECKPOINT_S3_URI=s3://picaivid-prod-media/artifacts/vggt/checkpoints/vggt_1B_commercial.pt
