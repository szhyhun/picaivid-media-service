# Copy to /etc/picaivid/media-cpu-worker.env on the CPU worker host.
# Do not commit the real /etc/picaivid/*.env files.
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Database and S3
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
AWS_REGION=us-west-2
S3_BUCKET=picaivid-prod-media

# The CPU worker consumes only Rails' timeline/assembly commands.
SQS_CPU_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/ACCOUNT_ID/picaivid-cpu-jobs
WORKER_TYPE=cpu
WORKER_PHASES=3,4

# Worker -> Rails callback authentication
RAILS_WEBHOOK_URL=https://YOUR_RAILS_HOST
MEDIA_SERVICE_WEBHOOK_KEY=replace-me

# Runware is called only from this private worker, never from Rails or React.
RUNWARE_API_KEY=replace-me
RUNWARE_MODEL=luma:ray@3.2
RUNWARE_DURATION_SECONDS=5
RUNWARE_RESOLUTION=720p
RUNWARE_HDR=true
RUNWARE_EXR_EXPORT=false
RUNWARE_OUTPUT_QUALITY=95
RUNWARE_INCLUDE_COST=false
RUNWARE_INPUT_MODE=url
RUNWARE_SUBMIT_CONCURRENCY=4
RUNWARE_POLL_INTERVAL_SECONDS=5.0
RUNWARE_MAX_POLL_ATTEMPTS=240
RUNWARE_SUBMIT_URL_EXPIRY_SECONDS=21600
