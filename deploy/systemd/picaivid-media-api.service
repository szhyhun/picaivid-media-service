[Unit]
Description=Picaivid Media Service API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/picaivid/picaivid-media-service
EnvironmentFile=/etc/picaivid/media-api.env
ExecStart=/usr/bin/bash -lc 'source venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}'
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
