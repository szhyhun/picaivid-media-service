# Environment
ENVIRONMENT=development
DEBUG=true

# API
API_KEY=dev-secret-key

# Database (same as Rails for reading photos)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/picaivid_rails_development

# AWS S3 (MinIO for local dev)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=picaivid-dev
S3_ENDPOINT=http://localhost:9000

# AWS SQS (LocalStack for local dev)
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/picaivid-jobs
SQS_ACCESS_KEY_ID=localstack
SQS_SECRET_ACCESS_KEY=localstack

# Worker Type (cpu or gpu)
WORKER_TYPE=cpu

# ML Models
MODEL_CACHE_DIR=./ml_models
OPENCLIP_MODEL=ViT-B-32
OPENCLIP_PRETRAINED=openai

# ZJU LoFTR strict config (no fallback allowed)
# NOTE: Set LOFTR_ZJU_REPO_DIR to your actual cloned zju3dv/LoFTR path.
LOFTR_ZJU_REPO_DIR=/Users/serhiizhyhun/Desktop/projects/picaivid/picaivid-media-service/third_party/LoFTR
LOFTR_ZJU_INDOOR_CKPT=/Users/serhiizhyhun/Desktop/projects/picaivid/picaivid-media-service/third_party/LoFTR/weights/indoor_legacy.ckpt
LOFTR_ZJU_INDOOR_DS_CKPT=/Users/serhiizhyhun/Desktop/projects/picaivid/picaivid-media-service/third_party/LoFTR/weights/indoor_ds_new.ckpt
LOFTR_ZJU_INDOOR_OT_CKPT=/Users/serhiizhyhun/Desktop/projects/picaivid/picaivid-media-service/third_party/LoFTR/weights/indoor_ot.ckpt
LOFTR_ZJU_OUTDOOR_DS_CKPT=/Users/serhiizhyhun/Desktop/projects/picaivid/picaivid-media-service/third_party/LoFTR/weights/outdoor_ds.ckpt
LOFTR_ZJU_OUTDOOR_OT_CKPT=/Users/serhiizhyhun/Desktop/projects/picaivid/picaivid-media-service/third_party/LoFTR/weights/outdoor_ot.ckpt

# MatchFormer debug config (strict, no fallback)
MATCHFORMER_REPO_DIR=/Users/serhiizhyhun/Desktop/projects/picaivid/picaivid-media-service/third_party/MatchFormer
MATCHFORMER_INDOOR_CKPT=/Users/serhiizhyhun/Desktop/projects/picaivid/picaivid-media-service/third_party/MatchFormer/model/weights/indoor-large-SEA.ckpt
MATCHFORMER_OUTDOOR_CKPT=/Users/serhiizhyhun/Desktop/projects/picaivid/picaivid-media-service/third_party/MatchFormer/model/weights/outdoor-large-LA.ckpt

# Logging (DEBUG shows all details, WARNING shows errors only)
LOG_LEVEL=DEBUG
RAILS_WEBHOOK_URL=http://localhost:3000
