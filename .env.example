# Environment
ENVIRONMENT=development
DEBUG=true

# API
API_KEY=dev-secret-key

# Database (same as Rails for reading photos)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/picaivid_development

# AWS S3
# On AWS, omit AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY and use the EC2 IAM role.
# For local MinIO only, set local credentials in your uncommitted .env if required.
AWS_REGION=us-east-1
S3_BUCKET=picaivid-dev
# S3_ENDPOINT=http://localhost:9000

# AWS SQS
# SQS_ENDPOINT is local-only for LocalStack. Omit it on AWS.
SQS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/picaivid-jobs
# SQS_ENDPOINT=http://localhost:4566

# Worker Type (cpu or gpu)
# Note: this is orchestration metadata; Torch runtime backend is auto-selected
# in code (cuda -> mps -> cpu) based on available hardware/wheels.
WORKER_TYPE=cpu

# ML Models
MODEL_CACHE_DIR=./ml_models
ANALYSIS_MATCH_ENGINE=mast3r_graph
MAST3R_REPO_DIR=../third_party/mast3r
MAST3R_MODEL_CHECKPOINT=../third_party/mast3r/checkpoints/MASt3R_ViTLarge_BaseDecoder_512_catmlpdpt_metric.pth
MAST3R_RETRIEVAL_CHECKPOINT=../third_party/mast3r/checkpoints/MASt3R_ViTLarge_BaseDecoder_512_catmlpdpt_metric_retrieval_trainingfree.pth
MAST3R_RETRIEVAL_CODEBOOK=../third_party/mast3r/checkpoints/MASt3R_ViTLarge_BaseDecoder_512_catmlpdpt_metric_retrieval_codebook.pkl
# S3 hydration fallback for staging/prod when local artifacts are missing.
# MAST3R_REPO_ARCHIVE_S3_URI=s3://picaivid-staging-media/artifacts/mast3r/mast3r.tar.gz
# MAST3R_MODEL_CHECKPOINT_S3_URI=s3://picaivid-staging-media/artifacts/mast3r/checkpoints/MASt3R_ViTLarge_BaseDecoder_512_catmlpdpt_metric.pth
# MAST3R_RETRIEVAL_CHECKPOINT_S3_URI=s3://picaivid-staging-media/artifacts/mast3r/checkpoints/MASt3R_ViTLarge_BaseDecoder_512_catmlpdpt_metric_retrieval_trainingfree.pth
# MAST3R_RETRIEVAL_CODEBOOK_S3_URI=s3://picaivid-staging-media/artifacts/mast3r/checkpoints/MASt3R_ViTLarge_BaseDecoder_512_catmlpdpt_metric_retrieval_codebook.pkl
OPENCLIP_MODEL=ViT-B-32
OPENCLIP_PRETRAINED=openai

# Logging
LOG_LEVEL=INFO
