# Environment
ENVIRONMENT=development
DEBUG=true

# API
API_KEY=dev-secret-key

# Database (same as Rails for reading photos)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/picaivid_development

# AWS S3
# On AWS, omit AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY and use the EC2 IAM role.
# For local MinIO only, set local credentials in your uncommitted .env if required.
AWS_REGION=us-east-1
S3_BUCKET=picaivid-dev
# S3_ENDPOINT=http://localhost:9000

# AWS SQS
# SQS_ENDPOINT is local-only for LocalStack. Omit it on AWS.
SQS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/picaivid-jobs
# SQS_ENDPOINT=http://localhost:4566

# Worker Type (cpu or gpu)
# Note: this is orchestration metadata; Torch runtime backend is auto-selected
# in code (cuda -> mps -> cpu) based on available hardware/wheels.
WORKER_TYPE=cpu
# For a local analysis-only run: WORKER_TYPE=gpu and WORKER_PHASES=1
# WORKER_PHASES=1

# VGGT runtime
MODEL_CACHE_DIR=./ml_models
ANALYSIS_MATCH_ENGINE=vggt_scene_graph
VGGT_REPO_DIR=../third_party/vggt-omega
VGGT_REPO_COMMIT=282ec70
VGGT_MODEL_CHECKPOINT=/absolute/path/to/vggt_omega_1b_512.pt
VGGT_DEVICE=auto
VGGT_PRECISION=auto
VGGT_IMAGE_SIZE=512
VGGT_IMAGE_MODE=balanced
VGGT_RETRY_WINDOW_SIZE=16
VGGT_RETRY_WINDOW_OVERLAP=6
VGGT_FINAL_WINDOW_SIZE=10
VGGT_FINAL_WINDOW_OVERLAP=4
VGGT_TRACK_POINTS_PER_IMAGE=64
VGGT_TRACK_GROUP_MAX=8
VGGT_MAX_GEOMETRY_POINTS_PER_PAIR=4096
ALLOW_SYNTHETIC_GEOMETRY=false
VGGT_USE_BUNDLE_ADJUSTMENT_EXPORT=false
# S3 hydration fallback for staging/prod when local artifacts are missing.
# VGGT_REPO_ARCHIVE_S3_URI=s3://picaivid-prod-media/artifacts/vggt/repo/vggt.tar.gz
# VGGT_MODEL_CHECKPOINT_S3_URI=s3://picaivid-prod-media/artifacts/vggt/checkpoints/vggt_omega_1b_512.pt
OPENCLIP_MODEL=ViT-B-32
OPENCLIP_PRETRAINED=openai

# Logging
LOG_LEVEL=INFO
