# Environment
ENVIRONMENT=development
DEBUG=true

# Internal API auth (Rails -> optional media API)
MEDIA_SERVICE_API_KEY=dev-secret-key
MEDIA_SERVICE_WEBHOOK_KEY=dev-webhook-key

# Database (same as Rails for reading photos)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/picaivid_development

# AWS S3
# On AWS, omit AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY and use the EC2 IAM role.
# For local MinIO only, set local credentials in your uncommitted .env if required.
AWS_REGION=us-east-1
S3_BUCKET=picaivid-dev
# S3_ENDPOINT=http://localhost:9000

# AWS SQS
# SQS_ENDPOINT is local-only for LocalStack. Omit it on AWS.
SQS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/picaivid-jobs
SQS_CPU_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/picaivid-cpu-jobs
# SQS_ENDPOINT=http://localhost:4566

# Worker Type (cpu or gpu)
# Note: this is orchestration metadata; Torch runtime backend is auto-selected
# in code (cuda -> mps -> cpu) based on available hardware/wheels.
WORKER_TYPE=cpu
# For a local analysis-only run: WORKER_TYPE=gpu and WORKER_PHASES=1
# WORKER_PHASES=1

# VGGT runtime
MODEL_CACHE_DIR=./ml_models
ANALYSIS_MATCH_ENGINE=vggt_scene_graph
VGGT_REPO_DIR=../third_party/vggt-omega
VGGT_REPO_COMMIT=282ec70
VGGT_MODEL_CHECKPOINT=/absolute/path/to/vggt_omega_1b_512.pt
VGGT_DEVICE=auto
VGGT_PRECISION=auto
VGGT_IMAGE_SIZE=512
VGGT_IMAGE_MODE=balanced
VGGT_IMAGE_SAVE_WORKERS=4
VGGT_PROFILE_STAGES=false
VGGT_MPS_CACHE_RELEASE_EVERY=25
VGGT_PAIR_CACHE_DIR=./tmp_sweep/cache
# S3 hydration fallback for staging/prod when local artifacts are missing.
# VGGT_REPO_ARCHIVE_S3_URI=s3://picaivid-prod-media/artifacts/vggt/repo/vggt.tar.gz
# VGGT_MODEL_CHECKPOINT_S3_URI=s3://picaivid-prod-media/artifacts/vggt/checkpoints/vggt_omega_1b_512.pt
OPENCLIP_MODEL=ViT-B-32
OPENCLIP_PRETRAINED=openai
OPENCLIP_BATCH_SIZE=16
# Object detector for real close-up subjects. Pre-download during worker setup;
# the running container is intentionally offline.
DETAIL_DETECTOR_MODEL=IDEA-Research/grounding-dino-tiny
DETAIL_DETECTOR_MIN_SCORE=0.35
DETAIL_DETECTOR_BATCH_SIZE=4

# Logging
LOG_LEVEL=INFO

# --- Video generation (Runware -> Luma Ray3.2) ----------------------------
# Keep this key only in the untracked worker .env file or the deployment secret store.
# Ray3.2 frame-to-frame generation requires a 5-second clip.
RUNWARE_API_KEY=
RUNWARE_API_URL=https://api.runware.ai/v1
RUNWARE_MODEL=luma:ray@3.2
RUNWARE_DURATION_SECONDS=5
RUNWARE_RESOLUTION=720p
RUNWARE_HDR=true
RUNWARE_EXR_EXPORT=false
RUNWARE_OUTPUT_QUALITY=95
RUNWARE_INCLUDE_COST=false
RUNWARE_INPUT_MODE=auto
RUNWARE_MAX_CONCURRENCY=4
RUNWARE_POLL_INTERVAL_SECONDS=5.0
